{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "crushBoostrapChoiceWindow",
    "CrushMainWindow",
    "CrushHello",
    "loginToRoblox",
    "serverInfoWindow",
    "crushOverlay"
  ],
  "permissions": [
    "core:default",
    "fs-pro:default",
    "opener:default",
    "cache:allow-set",
    "cache:allow-get",
    "cache:allow-has",
    "cache:allow-remove",
    "cache:allow-clear",
    "cache:allow-stats",
    "updater:allow-check",
    "updater:allow-download-and-install",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://discord.gg/EwhG5y5Yw9"
        },
        {
          "url": "https://cloud-config.mally.qzz.io/"
        }
      ]
    },
    "os:default",
    "dialog:default",
    "dialog:allow-open",
    "clipboard-manager:allow-write-text",
    "store:default",
    "core:window:default",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-start-dragging",
    "core:window:allow-set-size",
    "core:window:allow-center",
    "core:window:allow-show",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://cloud-config.mally.qzz.io/*"
        },
        {
          "url": "https://setup-ak.rbxcdn.com"
        },
        {
          "url": "https://setup-cfly.rbxcdn.com"
        },
        {
          "url": "https://setup-aws.rbxcdn.com"
        },
        {
          "url": "https://games.roblox.com/"
        },
        {
          "url": "https://thumbnails.roblox.com/"
        },
        {
          "url": "https://apis.roblox.com/"
        },
        {
          "url": "http://ip-api.com/json"
        },
        {
          "url": "https://crush-service.mally.qzz.io/*"
        },
        {
          "url": "https://*.rbxcdn.com/"
        },
        {
          "url": "https://users.roblox.com/v1/users/authenticated"
        },
        {
          "url": "https://github.com/klikos-modloader/marketplace/raw/refs/heads/main/mods/*"
        },
        {
          "url": "https://raw.githubusercontent.com/klikos-modloader/marketplace/*"
        },
        {
          "url": "https://raw.githubusercontent.com/RealMeddsam/config/*"
        },
        {
          "url": "https://gamejoin.roblox.com/v1/join-game-instance"
        },
        {
          "url": "https://get.geojs.io/v1/ip/geo/*"
        }
      ],
      "deny": [
        {
          "url": "https://placeholder.com"
        }
      ]
    },
    "log:default",
    "fs:default",
    "fs:allow-home-read-recursive",  
    "fs:allow-home-write-recursive",  
    "fs:allow-home-meta-recursive",
    "opener:allow-open-path",
    {
      "identifier": "fs:allow-mkdir",
      "allow": [
        {
          "path": "$APPDATA/**"
        },
        {
          "path": "$LOCALDATA/**"
        },
        {
          "path": "$CACHE/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-create",
      "allow": [
        {
          "path": "$APPDATA/**"
        },
        {
          "path": "$LOCALDATA/**"
        },
        {
          "path": "$CACHE/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-copy-file",
      "allow": [
        {
          "path": "$APPDATA/**"
        },
        {
          "path": "$LOCALDATA/**"
        },
        {
          "path": "$CACHE/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-remove",
      "allow": [
        {
          "path": "$APPDATA/**"
        },
        {
          "path": "$LOCALDATA/**"
        },
        {
          "path": "$CACHE/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-read-file",
      "allow": [
        {
          "path": "$APPDATA/**"
        },
        {
          "path": "$LOCALDATA/**"
        },
        {
          "path": "$CACHE/**"
        },
        {
          "path": "$HOME/**"
        },
        {
          "path": "$DOCUMENT/**"
        },
        {
          "path": "$DOWNLOAD/**"
        },
        {
          "path": "$DESKTOP/**"
        },
        {
          "path": "**"
        }
      ]
    },
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [
        {
          "path": "$APPDATA/**"
        },
        {
          "path": "$LOCALDATA/**"
        },
        {
          "path": "$CACHE/**"
        },
        {
          "path": "$RESOURCE/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [
        {
          "path": "$APPDATA/**"
        },
        {
          "path": "$LOCALDATA/**"
        },
        {
          "path": "$CACHE/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [
        {
          "path": "$APPDATA/**"
        },
        {
          "path": "$LOCALDATA/**"
        },
        {
          "path": "$CACHE/**"
        },
        {
          "path": "$TEMP/**"
        }
      ]
    },
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "$APPDATA/**"
        },
        {
          "path": "$LOCALDATA/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [
        {
          "path": "$APPDATA/**"
        },
        {
          "path": "$LOCALDATA/**"
        },
        {
          "path": "$CACHE/**"
        },
        {
          "path": "**"
        }
      ]
    },
    {
      "identifier": "fs:allow-read-dir",
      "allow": [
        {
          "path": "$APPDATA/**"
        },
        {
          "path": "$LOCALDATA/**"
        },
        {
          "path": "$CACHE/**"
        }
      ]
    },
    "notification:default",
    "cache:default"
  ]
}