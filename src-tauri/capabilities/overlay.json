{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "overlay",
  "description": "Capability for the AI overlay window",
  "windows": ["crushOverlay"],
  "permissions": [
    "core:default",
    "store:default",
    "log:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://huggingface.co/**" },
        { "url": "https://cdn-lfs.huggingface.co/**" },
        { "url": "https://cdn-lfs-us-1.huggingface.co/**" },
        { "url": "https://cdn.jsdelivr.net/**" }
      ]
    },
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [
        { "path": "$APPDATA/**" },
        { "path": "$RESOURCE/**" }
      ]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [
        { "path": "$APPDATA/**" },
        { "path": "$RESOURCE/**" }
      ]
    }
  ]
}
