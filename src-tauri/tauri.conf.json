{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "crush",
    "version": "0.2.3",
    "identifier": "com.mally.crush",
    "build": {
        "beforeDevCommand": "bun run dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "bun run build",
        "frontendDist": "../build"
    },
    "app": {
        "windows": [
            {
                "label": "crushBoostrapChoiceWindow",
                "title": "crushBoostrapChoiceWindow",
                "width": 500,
                "height": 250,
                "url": "/mainWin/choiceWin",
                "decorations": false,
                "center": true,
                "transparent": true
            }
        ],
        "security": {
            "csp": null,
            "assetProtocol": {
                "enable": true,
                "scope": ["$APPDATA/**"]
            }
        }
    },
    "bundle": {
        "createUpdaterArtifacts": true,
        "active": true,
        "targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "resources": [
            "./resources/**/*.png",
            "./resources/locales/**/*.json",

            "./resources/tortellini.jpg",

            "./resources/icon.ico",
            "./open_game.bat",

            "./libraries/swifttunnel.dll",
            "./libraries/swifttunnel.def",
            "./libraries/swifttunnel.exp"
        ]
    },
    "plugins": {
        "deep-link": {
            "desktop": {
                "schemes": ["roblox", "roblox-player"]
            }
        },
        "cli" : {
            "description": "CLI part for using shortcuts",
            "args": [
                {
                    "short" : "l",
                    "name" : "launch",
                    "description" : "Launch the game with the specified place id",
                    "takesValue" : true,
                    "required" : false
                }
            ]
        },
        "updater": {
            "endpoints": [
                "https://github.com/TheMallyGuy/crush/releases/latest/download/updater.json"
            ],
            "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkwRkUzQUYyRjk3QTRCQUYKUldTdlMzcjU4anIra0VVbVA0U1d0WlNLbnBtTjVENnZJcmtOcTJQdnN1V0p5TnNLMTRvbWNmbDAK",
            "windows": {
                "installMode": "passive"
            }
        }
    }
}
